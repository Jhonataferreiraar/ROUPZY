{
  "profile": "product-admin",
  "sourceRoots": ["app", "components", "lib"],
  "locale": "pt-BR",
  "canonicalMap": "UX-CONTRACT.md",
  "requiredCapabilities": ["Select/Listbox", "Date", "Form", "Scrollbar", "CRUD"],
  "ownership": {
    "Select/Listbox": "native",
    "Date": "typed"
  },
  "requiredCommands": ["lint", "typecheck", "test", "build"],
  "commands": {
    "lint": "npm run lint",
    "typecheck": "npm run typecheck",
    "test": "npm run test",
    "build": "npm run build"
  }
}
